{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>beste/renovate-config:default.json"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update agent tooling dependencies",
      "managerFilePatterns": [
        "/^home\\/\\.chezmoidata\\/agent-skills\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+version: \\\"(?<currentValue>[^\\\"]+)\\\""
      ]
    },
    {
      "customType": "regex",
      "description": "Update the reviewed minimum chezmoi version",
      "managerFilePatterns": [
        "/^\\.chezmoiversion$/"
      ],
      "matchStrings": [
        "^(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*$"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "twpayne/chezmoi"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["twpayne/chezmoi"],
      "automerge": false
    }
  ]
}
