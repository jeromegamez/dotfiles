{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>beste/renovate-config:default.json"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update shared agent skill dependencies",
      "managerFilePatterns": [
        "/^home\\/\\.chezmoidata\\/agent-skills\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+version: \\\"(?<currentValue>[^\\\"]+)\\\"",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+- source: https://github\\.com/[^/]+/[^/]+/tree/(?<currentValue>\\S+)"
      ]
    }
  ]
}
