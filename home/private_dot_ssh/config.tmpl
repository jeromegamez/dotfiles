{{ if eq .chezmoi.os "darwin" -}}
Match exec "test -x ~/.orbstack/bin/orb"
    Include ~/.orbstack/ssh/config
Match all
{{ end -}}
{{- if .personal }}
Match host github.com,gitlab.com,codeberg.org exec "test -n \"$AGENT_UNATTENDED\" && test -f ~/.ssh/id_ed25519_agent"
    IdentityAgent none
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519_agent
Match all
{{- end }}

Include ~/.ssh/1Password/generated-hosts.conf
Include ~/.ssh/1Password/config

Host *
{{- if eq .chezmoi.os "darwin" }}
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- else }}
    IdentityAgent ~/.1password/agent.sock
{{- end }}
