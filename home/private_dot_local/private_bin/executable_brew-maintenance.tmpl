#!/usr/bin/env bash

set -euo pipefail

brew_bin="{{ joinPath .homebrewPrefix "bin" "brew" }}"
brewfile="${XDG_CONFIG_HOME:-$HOME/.config}/homebrew/Brewfile"

if [[ ! -f "$brewfile" ]]; then
    echo "✗ Missing Brewfile: $brewfile"
    exit 1
fi

eval "$($brew_bin shellenv)" || true

echo "==> brew update"
$brew_bin update

echo "==> brew bundle install"
$brew_bin bundle install --no-upgrade --file="$brewfile"

echo "==> brew upgrade"
HOMEBREW_NO_UPGRADE_AUTO_UPDATES_CASKS=1 \
    HOMEBREW_NO_UPGRADE_QUIT_CASKS=1 \
    $brew_bin upgrade

echo "==> brew autoremove"
$brew_bin autoremove

echo "==> Hide Homebrew runtime commands"
runtime_formulae=(
    node
    {{ printf "python@%s" .versions.python.default | quote }}
)
for runtime_formula in "${runtime_formulae[@]}"; do
    if $brew_bin list --formula "$runtime_formula" >/dev/null 2>&1; then
        $brew_bin unlink "$runtime_formula"
    fi
done

echo "==> brew cleanup"
if ! $brew_bin cleanup; then
    echo "✗ brew cleanup failed"
    echo "Review only the paths reported by Homebrew, repair their ownership manually, and rerun brew-maintenance."
    exit 1
fi

echo "✓ Homebrew maintenance done"
