#!/usr/bin/env bash
# Script to exclude AI instruction files from git tracking without modifying .gitignore

set -euo pipefail

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Error: Not inside a git working tree." >&2
    exit 1
fi

exclude_file="$(git rev-parse --git-path info/exclude)"
mkdir -p "$(dirname "$exclude_file")"

# Optional AI notes that are not auto-loaded by default
AI_FILES=(
    "AI_INSTRUCTIONS.md"
    "AI_NOTES.md"
    "ANTHROPIC.md"
    "COPILOT.md"
    "GPT.md"
    "LLM_INSTRUCTIONS.md"
)

# Add each file to the exclude list if not already present
for file in "${AI_FILES[@]}"; do
    if grep -Fqx -- "$file" "$exclude_file" 2>/dev/null; then
        echo "$file is already excluded from git tracking."
    else
        if [[ -s "$exclude_file" && -n "$(tail -c 1 "$exclude_file")" ]]; then
            printf '\n' >>"$exclude_file"
        fi
        printf '%s\n' "$file" >>"$exclude_file"
        echo "Successfully excluded $file from git tracking."
    fi
done
