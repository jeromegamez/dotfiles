#!/usr/bin/env bash

set -euo pipefail

mise_bin={{ joinPath .homebrewPrefix "bin" "mise" | quote }}
pi_node={{ printf "node@%s" .versions.node.pi | quote }}
pi_entrypoint="$HOME/.pi/agent/bin/pi"

# Keep the npm installation usable until migration succeeds.
if [[ ! -x "$pi_entrypoint" || ! -f "$HOME/.pi/agent/install/current-version" ]]; then
    pi_entrypoint="${XDG_DATA_HOME:-$HOME/.local/share}/pi/bin/pi"
fi

if [[ ! -x "$pi_entrypoint" ]]; then
    echo "Pi is not installed at $pi_entrypoint; run chezmoi apply" >&2
    exit 127
fi

exec "$mise_bin" exec "$pi_node" -- "$pi_entrypoint" "$@"
