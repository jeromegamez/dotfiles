#!/usr/bin/env bash

set -euo pipefail

xdg_bin_dir="${XDG_BIN_DIR:-$HOME/.local/bin}"

"$xdg_bin_dir/brew-maintenance"

echo "==> chezmoi upgrade"
"$xdg_bin_dir/chezmoi" --verbose upgrade

{{ if .personal -}}
if [[ -x "$xdg_bin_dir/agy" ]]; then
    echo "==> agy update"
    "$xdg_bin_dir/agy" update
fi

if [[ -x "$xdg_bin_dir/codex" ]]; then
    echo "==> codex update"
    "$xdg_bin_dir/codex" update
fi
{{ end -}}
if command -v gcloud >/dev/null 2>&1; then
    echo "==> gcloud components update --quiet"
    gcloud components update --quiet
fi

{{ if .personal -}}
if [[ -x "$HOME/.pi/agent/bin/pi" || -x "${XDG_DATA_HOME:-$HOME/.local/share}/pi/bin/pi" ]]; then
    echo "==> pi update --all"
    "$xdg_bin_dir/pi" update --all
fi
{{ end -}}
if command -v gh >/dev/null 2>&1; then
    echo "==> gh extensions upgrade --all"
    gh extensions upgrade --all
fi

if [[ -x "$xdg_bin_dir/composer" ]]; then
    echo "==> composer self-update"
    "$xdg_bin_dir/composer" self-update
    echo "==> composer global update --with-all-dependencies"
    "$xdg_bin_dir/composer" global update --with-all-dependencies
fi

echo "✓ Maintenance done"
