#!/usr/bin/env bash

set -euo pipefail

config_key="agent.instructionsTrusted"

usage() {
    cat <<'EOF'
Usage: git trust-instructions [status|grant|revoke]

Manage explicit trust for repository instruction files in local Git config.
EOF
}

if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "Not inside a Git repository." >&2
    exit 1
fi

if (($# > 1)); then
    usage >&2
    exit 2
fi

action=${1:-status}

case "$action" in
    status)
        if trusted=$(git config --local --get --bool "$config_key"); then
            if [[ "$trusted" == "true" ]]; then
                echo "Repository instructions are explicitly trusted."
                exit 0
            fi
        else
            status=$?
            if ((status != 1)); then
                exit "$status"
            fi
        fi

        echo "Repository instructions are not explicitly trusted."
        exit 1
        ;;
    grant)
        git config --local "$config_key" true
        echo "Repository instruction trust granted."
        ;;
    revoke)
        if git config --local --get-all "$config_key" >/dev/null; then
            git config --local --unset-all "$config_key"
        fi
        echo "Repository instruction trust revoked."
        ;;
    help | -h | --help)
        usage
        ;;
    *)
        echo "Unknown action: $action" >&2
        usage >&2
        exit 2
        ;;
esac
