# History configuration
[[ -d "$XDG_STATE_HOME/zsh" ]] || mkdir -p "$XDG_STATE_HOME/zsh"
HISTFILE="$XDG_STATE_HOME"/zsh/history
HISTSIZE=200000 # Keep larger than SAVEHIST so duplicate expiry has room
SAVEHIST=100000

setopt AUTO_CD

setopt EXTENDED_HISTORY         # include timestamp
setopt HIST_BEEP                # beep if attempting to access a history entry which isn't there
setopt HIST_EXPIRE_DUPS_FIRST   # trim dupes first if history is full
setopt HIST_FIND_NO_DUPS        # do not display previously found command
setopt HIST_IGNORE_ALL_DUPS     # remove previously found command when entering it again
setopt HIST_IGNORE_SPACE        # do not save if line starts with space
setopt HIST_NO_STORE            # do not save history commands
setopt HIST_REDUCE_BLANKS       # strip superfluous blanks
setopt HIST_SAVE_BY_COPY        # write to temp file then move to avoid corruption
setopt HIST_SAVE_NO_DUPS        # omit older duplicates of newer commands
setopt HIST_VERIFY              # expand command line without executing it
setopt SHARE_HISTORY            # share history between sessions

# Enable completions (after PATH is set)
# Regenerate completion cache once per day, track freshness via stamp file.
zmodload zsh/datetime
zmodload -F zsh/stat b:zstat
autoload -Uz compinit
_zcompdump="$XDG_CACHE_HOME/zsh/zcompdump-$ZSH_VERSION"
_zcompdump_stamp="$_zcompdump.lastcheck"
[[ -d "${_zcompdump:h}" ]] || mkdir -p "${_zcompdump:h}"

typeset -A _zcompdump_stat
[[ -f "$_zcompdump_stamp" ]] && zstat -H _zcompdump_stat -- "$_zcompdump_stamp"
_zcompdump_mtime=${_zcompdump_stat[mtime]:-0}

if [[ -f "$_zcompdump" ]] && (( EPOCHSECONDS - _zcompdump_mtime < 86400 )); then
    compinit -C -d "$_zcompdump"
else
    compinit -d "$_zcompdump" && touch "$_zcompdump_stamp"
fi
unset _zcompdump_mtime _zcompdump_stat _zcompdump _zcompdump_stamp

# Completion configuration
zstyle ':completion::complete:*' use-cache on          # cache completions for better performance
zstyle ':completion:*' cache-path "$XDG_CACHE_HOME/zsh/zcompcache"
zstyle ':completion:*' rehash true                     # automatically find new executables in $PATH
zstyle ':completion:*' menu select                     # enable interactive menu selection
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'  # case-insensitive + partial matching
zstyle ':completion:*:default' list-colors ${(s.:.)LS_COLORS}  # colorize completion listings
zstyle ':completion:*' completer _complete _match _approximate  # enable fuzzy matching
zstyle ':completion:*:match:*' original only          # show only original matches
zstyle ':completion:*:approximate:*' max-errors 2     # allow up to 2 typos in fuzzy matching
zstyle ':completion:*' list-prompt '%S%M matches%s'   # show match count at bottom
zstyle ':completion:*:descriptions' format ''        # hide completion category headers
zstyle ':completion:*' group-name ''                  # group completions by category

[[ -o interactive ]] && bindkey -e

bindkey "\e[3~" delete-char        # Plain Delete
bindkey "\e[3;2~" delete-char      # Shift+Delete
bindkey "\e[3;3~" delete-char      # Alt+Delete
bindkey "\e[3;5~" delete-char      # Ctrl+Delete

# Cache tool init and completion scripts keyed by resolved path, mtime, size, and inode.
_source_cached_init() {
    local cache_name=$1 command_name=$2
    shift 2

    local executable=${commands[$command_name]}
    [[ -n "$executable" ]] || return

    local resolved=${executable:A}
    typeset -A _init_stat
    zstat -H _init_stat -- "$resolved" 2>/dev/null || return
    local fingerprint="${resolved}:${_init_stat[mtime]}:${_init_stat[size]}:${_init_stat[inode]}"

    local cache_dir="$XDG_CACHE_HOME/zsh/init"
    local cache_file="$cache_dir/$cache_name.zsh"
    local meta_file="$cache_file.meta"
    local cache_tmp="$cache_file.$$"
    local cached_fingerprint=""
    [[ -r "$meta_file" ]] && IFS= read -r cached_fingerprint <"$meta_file"

    if [[ ! -s "$cache_file" || "$cached_fingerprint" != "$fingerprint" ]]; then
        [[ -d "$cache_dir" ]] || mkdir -p "$cache_dir"
        if command "$@" >|"$cache_tmp"; then
            mv -f "$cache_tmp" "$cache_file"
            print -r -- "$fingerprint" >|"$meta_file"
        else
            rm -f "$cache_tmp"
        fi
    fi

    [[ -s "$cache_file" ]] && source "$cache_file"
}

# Load aliases and tools
source "${XDG_CONFIG_HOME}/zsh/aliases.zsh"
source "${XDG_CONFIG_HOME}/zsh/tools.zsh"

# Initialize prompt
if command -v starship &>/dev/null; then
    export STARSHIP_CONFIG="${XDG_CONFIG_HOME}/starship/starship.toml"
    _source_cached_init starship starship starship init zsh --print-full-init
fi
unfunction _source_cached_init

# Load widget-wrapping plugins last; syntax highlighting must be the final one.
{{- if eq .chezmoi.os "darwin" }}
[[ -f "{{ .homebrewPrefix }}/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] && \
    source "{{ .homebrewPrefix }}/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
[[ -f "{{ .homebrewPrefix }}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && \
    source "{{ .homebrewPrefix }}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
{{- end }}
