# Core PATH setup
# path uniqueness initialized in ~/.zshenv

# Essential paths (needed early)
{{ if eq .chezmoi.os "darwin" -}}
HOMEBREW_GNUBIN_DIR="{{ .homebrewPrefix }}/opt/make/libexec/gnubin"
path=("$HOMEBREW_GNUBIN_DIR" $path)
{{ end }}

{{ if eq .chezmoi.os "darwin" -}}
# Homebrew
eval "$({{ .homebrewPrefix }}/bin/brew shellenv)"
# Homebrew's shellenv prepends its prefix; restore user launchers and mise
# shims so dependency runtimes are not selected accidentally.
path=("$XDG_BIN_DIR" "$MISE_SHIMS_DIR" $path)

if [[ -f ${HOME}/.orbstack/shell/init.zsh ]]; then
    source ${HOME}/.orbstack/shell/init.zsh
fi

# 1Password SSH Agent
export SSH_AUTH_SOCK="${HOME}/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{ end }}

# Tool-specific paths
COMPOSER_BIN_DIR="${XDG_CONFIG_HOME}/composer/vendor/bin"
[[ -d "$COMPOSER_BIN_DIR" ]] && path+=("$COMPOSER_BIN_DIR")
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"
[[ -f "$XDG_DATA_HOME/google-cloud-sdk/path.zsh.inc" ]] && source "$XDG_DATA_HOME/google-cloud-sdk/path.zsh.inc"

export GNUPGHOME=${XDG_CONFIG_HOME}/gnupg

# See https://stackoverflow.com/a/52230415/284325
export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES

export DISABLE_TELEMETRY=1
export LESSHISTFILE="$XDG_STATE_HOME"/less/history
export SHELL_SESSIONS_DISABLE=1
unset PAGER

{{ if .personal -}}
export GITHUB_AUTH_TOKEN={{ .credentials.githubToken | quote }}
export MISE_GITHUB_TOKEN={{ .credentials.githubToken | quote }}
{{ end -}}

export CARGO_HOME="$XDG_DATA_HOME"/cargo
export DOCKER_CONFIG="$XDG_CONFIG_HOME"/docker
export GRADLE_USER_HOME="$XDG_DATA_HOME"/gradle
export NODE_REPL_HISTORY="$XDG_STATE_HOME"/node_repl_history
export NPM_CONFIG_CACHE="$XDG_CACHE_HOME"/npm
export PHP_HISTFILE="$XDG_STATE_HOME"/php/history
export RUSTUP_HOME="$XDG_DATA_HOME"/rustup
