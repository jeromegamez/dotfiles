# Initialize shell tools and integrations

_source_cached_init chezmoi chezmoi chezmoi completion zsh

if [[ -f "$XDG_DATA_HOME/google-cloud-sdk/completion.zsh.inc" ]]; then
    source "$XDG_DATA_HOME/google-cloud-sdk/completion.zsh.inc"
fi

if command -v aws_completer &>/dev/null; then
    (( $+functions[complete] )) || { autoload -Uz bashcompinit && bashcompinit; }
    complete -C "${commands[aws_completer]}" aws
fi

if command -v op &>/dev/null; then
    # eval "$(op completion zsh)"; compdef _op op
    [[ -f "${XDG_CONFIG_HOME}/op/plugins.sh" ]] && source "${XDG_CONFIG_HOME}/op/plugins.sh"
fi

_source_cached_init direnv direnv direnv hook zsh
_source_cached_init zoxide zoxide zoxide init zsh

# Initialize fzf (fuzzy finder)
if command -v fzf &>/dev/null; then
    # Use fd if available (respects .gitignore by default)
    if command -v fd &>/dev/null; then
        export FZF_DEFAULT_COMMAND='fd --type f'
        export FZF_CTRL_T_COMMAND='fd --type f'
        export FZF_ALT_C_COMMAND='fd --type d'
    fi

    _source_cached_init fzf fzf fzf --zsh

    # Replace the standard completion menu after fzf initialization.
{{- if eq .chezmoi.os "darwin" }}
    if [[ -f "{{ .homebrewPrefix }}/opt/fzf-tab/share/fzf-tab/fzf-tab.zsh" ]]; then
        zstyle ':completion:*' menu no
        source "{{ .homebrewPrefix }}/opt/fzf-tab/share/fzf-tab/fzf-tab.zsh"
    fi
{{- end }}
fi
