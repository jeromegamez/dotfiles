{{- /* chezmoi:modify-template */ -}}
{{- $raw := .chezmoi.stdin -}}
{{- $hadInput := ne (trim $raw) "" -}}
{{- $orig := dict -}}
{{- if $hadInput -}}
{{-   $orig = fromJson $raw -}}
{{- end -}}
{{- $cfg := deepCopy $orig -}}
{{- $cfg = setValueAtPath "allowNonWorkspaceAccess" true $cfg -}}
{{- $cfg = setValueAtPath "queuedMessages" "send-immediately" $cfg -}}
{{- $cfg = setValueAtPath "toolPermission" "always-proceed" $cfg -}}
{{- $workspaces := list -}}
{{- if and (hasKey $cfg "trustedWorkspaces") (kindIs "slice" (index $cfg "trustedWorkspaces")) -}}
{{-   range (index $cfg "trustedWorkspaces") -}}
{{-     $workspaces = append $workspaces . -}}
{{-   end -}}
{{- end -}}
{{- range (list (joinPath .chezmoi.homeDir ".local" "share" "chezmoi") (joinPath .chezmoi.homeDir "Code")) -}}
{{-   if not (has . $workspaces) -}}
{{-     $workspaces = append $workspaces . -}}
{{-   end -}}
{{- end -}}
{{- $cfg = setValueAtPath "trustedWorkspaces" $workspaces $cfg -}}
{{- if and $hadInput (deepEqual $orig $cfg) -}}
{{- $raw -}}
{{- else -}}
{{- $cfg | toPrettyJson }}
{{ end -}}
