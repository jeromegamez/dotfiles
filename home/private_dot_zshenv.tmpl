typeset -U path
export XDG_BIN_DIR="$HOME/.local/bin"
path=("$XDG_BIN_DIR" $path)
{{ if eq .chezmoi.os "darwin" -}}
export XDG_CACHE_HOME="$HOME/Library/Caches"
{{ else -}}
export XDG_CACHE_HOME=$HOME/.cache
{{- end -}}
export XDG_CONFIG_HOME=$HOME/.config
export XDG_DATA_HOME=$HOME/.local/share
export XDG_STATE_HOME=$HOME/.local/state

# opencode
[[ -d "${HOME}/.opencode/bin" ]] && path=("${HOME}/.opencode/bin" $path)

{{ if eq .chezmoi.os "darwin" -}}
typeset -U fpath
fpath=(
    "{{ .homebrewPrefix }}/share/zsh-completions"
    "{{ .homebrewPrefix }}/share/zsh/site-functions"
    "{{ .homebrewPrefix }}/opt/zsh/share/zsh/functions"
    ${fpath:#{{ .homebrewPrefix }}/Cellar/zsh/*/share/zsh/functions}
)

export EDITOR={{ joinPath .homebrewPrefix "bin" "nvim" }}
export VISUAL=$EDITOR
{{- end }}
ZDOTDIR=$XDG_CONFIG_HOME/zsh
