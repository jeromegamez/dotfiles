{{- $profile := promptChoiceOnce
    . "profile"
    "Select this machine's profile"
    (list "personal" "work")
-}}
{{- $work := eq $profile "work" -}}
{{- $personal := eq $profile "personal" -}}
{{- $headless := promptBoolOnce
    . "headless"
    "Is this machine headless?"
    false
-}}

{{- $email := promptStringOnce
    . "email"
    (printf "%s email" (title $profile))
    | trim
-}}
{{- if eq $email "" -}}
{{- fail "Email must not be empty" -}}
{{- end -}}

{{- $workGitSigningPublicKey := "" -}}
{{- if $work -}}
{{- $workGitSigningPublicKey = promptStringOnce
    . "workGitSigningPublicKey"
    "Work SSH public key for Git commit and tag signing"
    | trim
-}}
{{- if not (or (hasPrefix "ssh-ed25519 " $workGitSigningPublicKey) (hasPrefix "ssh-rsa " $workGitSigningPublicKey)) -}}
{{- fail "Work Git signing public key must be an Ed25519 or RSA OpenSSH public key supported by 1Password" -}}
{{- end -}}
{{- end -}}

{{- $onepasswordAccount := promptStringOnce
    . "onepasswordAccount"
    (printf "1Password account ID or sign-in address for the %s profile" $profile)
    | trim
-}}
{{- if eq $onepasswordAccount "" -}}
{{- fail "1Password account must not be empty" -}}
{{- end -}}
{{- $githubRateLimitTokenReference := promptStringOnce
    . "githubRateLimitTokenReference"
    "1Password secret reference for the GitHub API rate-limit PAT"
-}}
{{- $githubRateLimitTokenReference = $githubRateLimitTokenReference | trim | trimAll "\"'" -}}
{{- if not (hasPrefix "op://" $githubRateLimitTokenReference) -}}
{{- fail "GitHub API rate-limit PAT reference must start with op://" -}}
{{- end -}}

[data]
    profile = {{ $profile | quote }}
    work = {{ $work }}
    personal = {{ $personal }}
    headless = {{ $headless }}
    email = {{ $email | quote }}
{{- if $work }}
    workGitSigningPublicKey = {{ $workGitSigningPublicKey | quote }}
{{- end }}
    onepasswordAccount = {{ $onepasswordAccount | quote }}
    githubRateLimitTokenReference = {{ $githubRateLimitTokenReference | quote }}
{{- if eq .chezmoi.os "darwin" }}
    homebrewPrefix = "/opt/homebrew"
{{- end }}
