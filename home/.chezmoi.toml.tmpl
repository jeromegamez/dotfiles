{{- $profile := promptChoiceOnce
    . "profile"
    "Select this machine's profile"
    (list "personal" "work")
-}}
{{- $work := eq $profile "work" -}}
{{- $personal := eq $profile "personal" -}}

{{- $personalGitEnabled := $personal -}}
{{- $workGitEnabled := $work -}}

{{- $personalEmail := "" -}}
{{- $personalSshPublicKey := "" -}}
{{- if $personalGitEnabled -}}
{{- $personalEmail = promptStringOnce . "personalEmail" "Personal Git email" | trim -}}
{{- $personalSshPublicKey = promptStringOnce
    . "personalSshPublicKey"
    "Personal SSH authentication public key"
    | trim
-}}
{{- if eq $personalEmail "" -}}
{{- fail "Personal Git email must not be empty" -}}
{{- end -}}
{{- if not (or (hasPrefix "ssh-" $personalSshPublicKey) (hasPrefix "ecdsa-" $personalSshPublicKey) (hasPrefix "sk-" $personalSshPublicKey)) -}}
{{- fail "Personal SSH public key must use an OpenSSH public key format" -}}
{{- end -}}
{{- end -}}

{{- $workEmail := "" -}}
{{- $workSshPublicKey := "" -}}
{{- if $workGitEnabled -}}
{{- $workEmail = promptStringOnce . "workEmail" "Work Git email" | trim -}}
{{- $workSshPublicKey = promptStringOnce
    . "workSshPublicKey"
    "Work SSH authentication and signing public key"
    | trim
-}}
{{- if eq $workEmail "" -}}
{{- fail "Work Git email must not be empty" -}}
{{- end -}}
{{- if not (or (hasPrefix "ssh-" $workSshPublicKey) (hasPrefix "ecdsa-" $workSshPublicKey) (hasPrefix "sk-" $workSshPublicKey)) -}}
{{- fail "Work SSH public key must use an OpenSSH public key format" -}}
{{- end -}}
{{- end -}}

{{- $email := $personalEmail -}}
{{- if $work -}}
{{- $email = $workEmail -}}
{{- end -}}
{{- $onepasswordAccount := promptStringOnce
    . "onepasswordAccount"
    (printf "1Password account ID or sign-in address for the %s profile" $profile)
-}}
{{- $githubRateLimitTokenReference := promptStringOnce
    . "githubRateLimitTokenReference"
    "1Password secret reference for the GitHub API rate-limit PAT"
-}}
{{- $githubRateLimitTokenReference = $githubRateLimitTokenReference | trim | trimAll "\"'" -}}
{{- if not (hasPrefix "op://" $githubRateLimitTokenReference) -}}
{{- fail "GitHub API rate-limit PAT reference must start with op://" -}}
{{- end -}}

[data]
    profile = {{ $profile | quote }}
    work = {{ $work }}
    personal = {{ $personal }}
    email = {{ $email | quote }}
    personalGitEnabled = {{ $personalGitEnabled }}
    workGitEnabled = {{ $workGitEnabled }}
{{- if $personalGitEnabled }}
    personalEmail = {{ $personalEmail | quote }}
    personalSshPublicKey = {{ $personalSshPublicKey | quote }}
{{- end }}
{{- if $workGitEnabled }}
    workEmail = {{ $workEmail | quote }}
    workSshPublicKey = {{ $workSshPublicKey | quote }}
{{- end }}
    onepasswordAccount = {{ $onepasswordAccount | quote }}
    githubRateLimitTokenReference = {{ $githubRateLimitTokenReference | quote }}
{{- if eq .chezmoi.os "darwin" }}
    homebrewPrefix = "/opt/homebrew"
{{- end }}
