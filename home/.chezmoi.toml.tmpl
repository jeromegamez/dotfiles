{{- $profile := promptChoiceOnce
    . "profile"
    "Select this machine's profile"
    (list "personal" "work")
-}}
{{- $work := eq $profile "work" -}}
{{- $personal := eq $profile "personal" -}}

{{- $email := promptStringOnce . "email" "Git commit email" -}}

[data]
    profile = {{ $profile | quote }}
    work = {{ $work }}
    personal = {{ $personal }}
    onepasswordAccount = "UM5PFDCXWRDOXA2MBGNTMSFJ24"
{{- if eq .chezmoi.os "darwin" }}
    homebrewPrefix = "/opt/homebrew"
{{- end }}

[data.credentials]
    githubToken = {{ onepasswordRead "op://private/GitHub/Personal Access Tokens/Avoid Rate Limits" .onepasswordAccount | trim | quote }}
    githubComposerToken = {{ onepasswordRead "op://private/GitHub/Personal Access Tokens/Composer" .onepasswordAccount | trim | quote }}

[data.git]
    email = {{ $email | quote }}

[data.macos]
    timezone = "Europe/Berlin"
