{{- $work := false -}}{{/* true if this machine is a work machine */}}
{{- $personal := false -}}{{/* true if this machine should have personal secrets */}}

{{/* work around unreliable hostname on darwin */}}
{{- $hostname := .chezmoi.hostname -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $hostname := output "scutil" "--get" "LocalHostName" | trim -}}
{{- end -}}

{{- if eq $hostname "***REMOVED***" -}}
{{-   $work = true -}}
{{- else if eq $hostname "kerngehaeuse" -}}
{{-   $personal = true -}}
{{- end -}}

{{- $name := "Jérôme Gamez" -}}

{{- $email := "jerome@gamez.name" -}}
{{- $workEmail := "***REMOVED***" -}}

{{- if $work -}}
{{-   $email = $workEmail -}}
{{- end -}}

[data]
    work = {{ $work }}
    personal = {{ $personal }}
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    onepasswordAccount = "UM5PFDCXWRDOXA2MBGNTMSFJ24"
{{- if eq .chezmoi.os "darwin" }}
    computername = "Kerngehäuse"
    hostname = "kerngehaeuse"
    homebrewPrefix = "/opt/homebrew"
{{- end }}

[data.credentials]
    githubToken = {{ onepasswordRead "op://private/GitHub/Personal Access Tokens/Avoid Rate Limits" .onepasswordAccount | trim | quote }}
    githubComposerToken = {{ onepasswordRead "op://private/GitHub/Personal Access Tokens/Composer" .onepasswordAccount | trim | quote }}
    gitlabToken = {{ onepasswordRead "op://private/Gitlab read_api token/credential" .onepasswordAccount | trim | quote }}

[data.git]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    signingKey = "4E902530D3BC24D1"

[data.git.work]
    email = {{ $workEmail | quote }}
    directory = "~/Code/work/"

[data.versions]
    phpVersions = ["8.4", "8.5"]

[data.macos]
    timezone = "Europe/Berlin"
