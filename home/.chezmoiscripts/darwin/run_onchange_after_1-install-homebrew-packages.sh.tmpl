#!/usr/bin/env bash

set -eufo pipefail

eval "$({{ joinPath .homebrewPrefix "bin" "brew" }} shellenv)" || true

# Brewfile hash: {{ includeTemplate "homebrew/Brewfile.tmpl" . | sha256sum }}
# chezmoi.toml hash: {{ include (joinPath .chezmoi.sourceDir ".chezmoi.toml.tmpl") | sha256sum }}

brewfile="${XDG_CONFIG_HOME:-$HOME/.config}/homebrew/Brewfile"
HOMEBREW_CASK_OPTS=--no-quarantine {{ joinPath .homebrewPrefix "bin" "brew" }} bundle install --file="$brewfile"

# compinit rejects completion paths whose parent directories are group-writable.
zsh_completion_parent={{ joinPath .homebrewPrefix "share" | quote }}
if [[ -O "$zsh_completion_parent" ]]; then
    chmod go-w "$zsh_completion_parent"
fi

echo "✓ Homebrew setup completed"
