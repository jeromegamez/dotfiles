#!/usr/bin/env bash

set -euo pipefail

PLUGIN_BINARY="${HOME}/.local/bin/session-manager-plugin"
PLUGIN_INSTALL_DIR="${HOME}/.local/share/aws/session-manager-plugin"
AWS_APPLICATION_IDENTITY="Developer ID Application: AMZN Mobile LLC (94KV3E626L)"
AWS_TEAM_ID="94KV3E626L"
temp_dir=""

is_verbose() {
    [[ -n "${CHEZMOI_VERBOSE:-}" ]]
}

log_verbose() {
    if is_verbose; then
        echo "$@"
    fi
}

run_with_output_if_verbose() {
    if is_verbose; then
        "$@"
    else
        "$@" >/dev/null
    fi
}

# Architecture detection in template
{{ if eq .chezmoi.arch "arm64" -}}
BUNDLE_URL="https://s3.amazonaws.com/session-manager-downloads/plugin/latest/mac_arm64/sessionmanager-bundle.zip"
{{ else -}}
BUNDLE_URL="https://s3.amazonaws.com/session-manager-downloads/plugin/latest/mac/sessionmanager-bundle.zip"
{{ end -}}

cleanup() {
    if [[ -n "$temp_dir" && -d "$temp_dir" ]]; then
        rm -rf -- "$temp_dir"
    fi
}

trap cleanup EXIT INT TERM

get_latest_version() {
    curl -fsSL "https://api.github.com/repos/aws/session-manager-plugin/releases/latest" |
        python3 -c 'import json, sys; print(json.load(sys.stdin)["tag_name"].lstrip("v"))'
}

get_installed_version() {
    if [[ -x "$PLUGIN_BINARY" ]]; then
        "$PLUGIN_BINARY" --version 2>/dev/null | awk '{print $1}'
    fi
}

verify_binary() {
    local binary_path="$1"
    local signature

    if ! codesign --verify --strict "$binary_path"; then
        echo "AWS Session Manager Plugin has an invalid Apple code signature"
        exit 1
    fi

    if ! signature=$(codesign --display --verbose=2 "$binary_path" 2>&1); then
        echo "Could not inspect the AWS Session Manager Plugin code signature"
        exit 1
    fi

    if [[ "$signature" != *"Authority=$AWS_APPLICATION_IDENTITY"* || "$signature" != *"TeamIdentifier=$AWS_TEAM_ID"* ]]; then
        echo "AWS Session Manager Plugin has an unexpected signing identity"
        exit 1
    fi

    log_verbose "AWS Session Manager Plugin code signature verified"
}

install_plugin() {
    local message="$1"
    local archive_path
    local bundle_dir
    local bundle_version
    local source_binary

    temp_dir=$(mktemp -d)
    archive_path="${temp_dir}/sessionmanager-bundle.zip"
    bundle_dir="${temp_dir}/sessionmanager-bundle"
    log_verbose "$message"

    log_verbose "Downloading plugin bundle..."
    curl -fsSL "$BUNDLE_URL" -o "$archive_path"
    ditto -x -k "$archive_path" "$temp_dir"

    source_binary="${bundle_dir}/bin/session-manager-plugin"
    bundle_version=$(tr -d '[:space:]' <"${bundle_dir}/VERSION")
    if [[ "$bundle_version" != "$LATEST_VERSION" ]]; then
        echo "AWS Session Manager Plugin version mismatch: expected $LATEST_VERSION, downloaded $bundle_version"
        exit 1
    fi

    log_verbose "Verifying plugin signature..."
    verify_binary "$source_binary"

    log_verbose "Installing plugin under $PLUGIN_INSTALL_DIR..."
    mkdir -p "${PLUGIN_INSTALL_DIR}/bin" "${HOME}/.local/bin"
    cp "$source_binary" "${PLUGIN_INSTALL_DIR}/bin/session-manager-plugin"
    cp "${bundle_dir}/seelog.xml.template" "${bundle_dir}/VERSION" "${bundle_dir}/LICENSE" "$PLUGIN_INSTALL_DIR/"

    log_verbose "Linking plugin into ~/.local/bin..."
    run_with_output_if_verbose ln -sfn "${PLUGIN_INSTALL_DIR}/bin/session-manager-plugin" "$PLUGIN_BINARY"
}

LATEST_VERSION=$(get_latest_version)
INSTALLED_VERSION=$(get_installed_version)

if [[ -z "$INSTALLED_VERSION" || "$INSTALLED_VERSION" != "$LATEST_VERSION" ]]; then
    install_plugin "Installing AWS Session Manager Plugin (latest: $LATEST_VERSION, installed: ${INSTALLED_VERSION:-none})..."
    log_verbose "AWS Session Manager Plugin updated successfully to $LATEST_VERSION"
else
    log_verbose "AWS Session Manager Plugin is up to date ($INSTALLED_VERSION)"
fi
