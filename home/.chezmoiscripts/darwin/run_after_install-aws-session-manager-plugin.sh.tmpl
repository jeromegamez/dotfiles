#!/usr/bin/env bash

set -euo pipefail

PLUGIN_BINARY="${HOME}/.local/bin/session-manager-plugin"
AWS_INSTALLER_IDENTITY="Developer ID Installer: AMZN Mobile LLC (94KV3E626L)"
temp_dir=""

is_verbose() {
    [[ -n "${CHEZMOI_VERBOSE:-}" ]]
}

log_verbose() {
    if is_verbose; then
        echo "$@"
    fi
}

run_with_output_if_verbose() {
    if is_verbose; then
        "$@"
    else
        "$@" >/dev/null
    fi
}

# Architecture detection in template
{{ if eq .chezmoi.arch "arm64" -}}
PKG_URL="https://s3.amazonaws.com/session-manager-downloads/plugin/latest/mac_arm64/session-manager-plugin.pkg"
{{ else -}}
PKG_URL="https://s3.amazonaws.com/session-manager-downloads/plugin/latest/mac/session-manager-plugin.pkg"
{{ end -}}

cleanup() {
    if [[ -n "$temp_dir" && -d "$temp_dir" ]]; then
        rm -f -- "$temp_dir/session-manager-plugin.pkg"
        rmdir -- "$temp_dir" 2>/dev/null || true
    fi
}

trap cleanup EXIT INT TERM

get_latest_version() {
    curl -fsSL "https://api.github.com/repos/aws/session-manager-plugin/releases/latest" |
        python3 -c 'import json, sys; print(json.load(sys.stdin)["tag_name"].lstrip("v"))'
}

get_installed_version() {
    if command -v session-manager-plugin >/dev/null 2>&1; then
        session-manager-plugin --version 2>/dev/null | awk '{print $1}'
    fi
}

verify_package() {
    local package_path="$1"
    local signature

    if ! signature=$(pkgutil --check-signature "$package_path"); then
        echo "✗ AWS Session Manager package has no trusted Apple signature"
        exit 1
    fi

    if [[ "$signature" != *"$AWS_INSTALLER_IDENTITY"* ]]; then
        echo "✗ AWS Session Manager package has an unexpected signing identity"
        exit 1
    fi

    if ! spctl --assess --type install "$package_path"; then
        echo "✗ AWS Session Manager package failed the macOS security assessment"
        exit 1
    fi

    log_verbose "✓ AWS Session Manager package signature verified"
}

install_plugin() {
    local message="$1"
    local package_path

    temp_dir=$(mktemp -d)
    package_path="${temp_dir}/session-manager-plugin.pkg"
    log_verbose "$message"

    log_verbose "Downloading plugin..."
    curl -fsSL "$PKG_URL" -o "$package_path"

    log_verbose "Verifying package signature..."
    verify_package "$package_path"

    log_verbose "Installing package..."
    run_with_output_if_verbose sudo installer -pkg "$package_path" -target /

    log_verbose "Creating symlink..."
    mkdir -p "${HOME}/.local/bin"
    run_with_output_if_verbose ln -sfv /usr/local/sessionmanagerplugin/bin/session-manager-plugin "$PLUGIN_BINARY"
}

LATEST_VERSION=$(get_latest_version)
INSTALLED_VERSION=$(get_installed_version)

if [[ -z "$INSTALLED_VERSION" || "$INSTALLED_VERSION" != "$LATEST_VERSION" ]]; then
    install_plugin "Installing AWS Session Manager Plugin (latest: $LATEST_VERSION, installed: ${INSTALLED_VERSION:-none})..."
    log_verbose "✓ AWS Session Manager Plugin updated successfully to $LATEST_VERSION"
else
    log_verbose "✓ AWS Session Manager Plugin is up to date ($INSTALLED_VERSION)"
fi
