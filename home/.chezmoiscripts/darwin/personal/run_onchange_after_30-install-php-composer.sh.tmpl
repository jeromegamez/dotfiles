#!/usr/bin/env bash

set -eufo pipefail

umask 077

# Composer package declarations hash: {{ include (joinPath .chezmoi.sourceDir "private_dot_config/private_composer/composer.json") | sha256sum }}

temp_dir=""
installer=""
cleanup() {
    if [[ -n "$installer" ]]; then
        rm -f -- "$installer"
    fi
    if [[ -n "$temp_dir" ]]; then
        rmdir -- "$temp_dir" 2>/dev/null || true
    fi
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

PHP_BIN={{ joinPath .homebrewPrefix "bin" "php" | quote }}
if [[ ! -x "$PHP_BIN" ]]; then
    echo "Missing PHP executable: $PHP_BIN" >&2
    exit 1
fi

COMPOSER_PATH="${XDG_BIN_DIR:-$HOME/.local/bin}"
COMPOSER_FILE_NAME="composer"

if [ ! -f "${COMPOSER_PATH}/${COMPOSER_FILE_NAME}" ]; then
    mkdir -p "${COMPOSER_PATH}"
    temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/chezmoi-composer.XXXXXX")
    installer="${temp_dir}/composer-setup.php"

    EXPECTED_CHECKSUM="$(curl -fsSL https://composer.github.io/installer.sig)"
    if [[ ! "$EXPECTED_CHECKSUM" =~ ^[0-9a-f]{96}$ ]]; then
        >&2 echo 'ERROR: Invalid installer signature format'
        exit 1
    fi

    curl -fsSL -o "$installer" https://getcomposer.org/installer
    ACTUAL_CHECKSUM="$(shasum -a 384 "$installer" | awk '{print $1}')"

    if [[ "$EXPECTED_CHECKSUM" != "$ACTUAL_CHECKSUM" ]]; then
        >&2 echo 'ERROR: Invalid installer checksum'
        exit 1
    fi

    "$PHP_BIN" "$installer" --install-dir="${COMPOSER_PATH}" --filename="${COMPOSER_FILE_NAME}"
fi

COMPOSER_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/composer" \
    "$PHP_BIN" "${COMPOSER_PATH}/${COMPOSER_FILE_NAME}" global update --quiet --with-all-dependencies

echo "✓ Updated global Composer packages"
