#!/usr/bin/env bash

set -euo pipefail

homebrew_prefix={{ .homebrewPrefix | quote }}
homebrew_bin="$homebrew_prefix/bin"
node_bin="$homebrew_bin/node"
npm_bin="$homebrew_bin/npm"
data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
pi_prefix="$data_home/pi"
pi_agent_dir="$HOME/.pi/agent"
pi_entrypoint="$pi_agent_dir/bin/pi"
pi_launcher="$HOME/.local/bin/pi"
pi_package="@earendil-works/pi-coding-agent"
installer=""

cleanup() {
    if [[ -n "$installer" && -f "$installer" ]]; then
        rm -f -- "$installer"
    fi
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if [[ ! -x "$node_bin" || ! -x "$npm_bin" ]]; then
    echo "Missing Homebrew Node.js runtime under $homebrew_bin" >&2
    exit 1
fi

if [[ ! -x "$pi_entrypoint" || ! -f "$pi_agent_dir/install/current-version" ]]; then
    echo "==> Install managed Pi"
    installer="$(mktemp "${TMPDIR:-/tmp}/pi-installer.XXXXXX")"
    curl -fsSL https://pi.dev/install.sh -o "$installer"
    PATH="$pi_prefix/bin:$pi_agent_dir/bin:$homebrew_bin:/usr/bin:/bin:/usr/sbin:/sbin" \
        PI_CODING_AGENT_DIR="$pi_agent_dir" \
        sh "$installer"
    if [[ ! -x "$pi_entrypoint" || ! -f "$pi_agent_dir/install/current-version" ]]; then
        echo "Managed Pi installation was not activated at $pi_entrypoint" >&2
        exit 1
    fi
fi

if [[ ! -x "$pi_launcher" ]]; then
    echo "Missing managed Pi launcher: $pi_launcher" >&2
    exit 1
fi

"$pi_launcher" --version

if [[ -d "$homebrew_prefix/lib/node_modules/$pi_package" ]]; then
    echo "==> Remove legacy Pi installation from the Homebrew npm prefix"
    "$npm_bin" uninstall \
        --global \
        --ignore-scripts \
        --prefix "$homebrew_prefix" \
        --no-audit \
        --no-fund \
        "$pi_package"
fi

echo "✓ Pi uses Homebrew Node.js"
