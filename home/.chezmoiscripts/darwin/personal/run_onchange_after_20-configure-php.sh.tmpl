#!/usr/bin/env bash

set -euo pipefail

php_versions=(
{{- range .versions.php.installed }}
    {{ . | quote }}
{{- end }}
)

configured=0

for version in "${php_versions[@]}"; do
    conf_dir="{{ .homebrewPrefix }}/etc/php/${version}/conf.d"
    if [[ ! -d "$conf_dir" ]]; then
        echo "Missing PHP configuration directory: $conf_dir" >&2
        continue
    fi

    cat <<'EOF' >"${conf_dir}/99-memory-limits.ini"
memory_limit = -1
xdebug.mode = off
EOF
    configured=$((configured + 1))
done

if ((configured == 0)); then
    echo "No PHP configuration directories were found to configure" >&2
    exit 1
fi

echo "✓ Configured PHP settings ($configured versions)"
