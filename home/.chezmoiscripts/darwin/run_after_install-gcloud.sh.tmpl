#!/usr/bin/env bash

set -euo pipefail

SDK_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/google-cloud-sdk"
managed_gcloud_bin="${SDK_DIR}/bin/gcloud"
temp_parent="${TMPDIR:-/tmp}"
temp_parent="${temp_parent%/}"

is_verbose() {
    [[ -n "${CHEZMOI_VERBOSE:-}" ]]
}

log_verbose() {
    if is_verbose; then
        echo "$@"
    fi
}

cleanup() {
    if [[ -n "${temp_dir:-}" && "$temp_dir" == "$temp_parent"/chezmoi-gcloud.* && -d "$temp_dir" ]]; then
        rm -rf -- "$temp_dir"
    fi
}

trap cleanup EXIT INT TERM

# Architecture detection in template
{{ if eq .chezmoi.arch "arm64" -}}
DOWNLOAD_URL="https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-darwin-arm.tar.gz"
{{ else -}}
DOWNLOAD_URL="https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-darwin-x86_64.tar.gz"
{{ end -}}

if [[ ! -x "$managed_gcloud_bin" ]] && ! command -v gcloud >/dev/null 2>&1; then
    log_verbose "Installing Google Cloud CLI..."
    temp_dir=$(mktemp -d "$temp_parent/chezmoi-gcloud.XXXXXX")
    archive_path="${temp_dir}/google-cloud-cli.tar.gz"

    log_verbose "Downloading Google Cloud SDK..."
    curl -fsSL "$DOWNLOAD_URL" -o "$archive_path"

    log_verbose "Checking archive readability..."
    tar -tzf "$archive_path" >/dev/null

    log_verbose "Extracting archive..."
    tar -xzf "$archive_path" -C "$temp_dir"

    sdk_source_dir=$(find "$temp_dir" -maxdepth 1 -type d -name 'google-cloud-*' | head -n 1)
    if [[ -z "$sdk_source_dir" ]]; then
        echo "✗ Google Cloud SDK archive missing expected directory"
        exit 1
    fi

    log_verbose "Running installation script..."
    bash "$sdk_source_dir/install.sh" \
        --usage-reporting false \
        --path-update false \
        --command-completion false \
        --install-python false \
        >/dev/null 2>&1

    if [[ ! -x "$managed_gcloud_bin" ]]; then
        echo "✗ Google Cloud CLI install failed"
        exit 1
    fi

    echo "✓ Installed Google Cloud CLI"
fi
