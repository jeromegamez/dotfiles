#!/usr/bin/env bash

set -euo pipefail

TARGET_SHELL="{{ joinPath .homebrewPrefix "bin" "zsh" }}"
SHELLS_FILE="/etc/shells"
USER_NAME="$(id -un)"

log_verbose() {
    if [[ -n "${CHEZMOI_VERBOSE:-}" ]]; then
        echo "$@"
    fi
}

# Get actual login shell (more reliable than $SHELL)
CURRENT_SHELL="$(dscl . -read "/Users/$USER_NAME" UserShell | awk '{print $2}')"

if [[ -z "$CURRENT_SHELL" ]]; then
    echo "Could not read current login shell for $USER_NAME"
    exit 1
fi

{{ if .work -}}
if [[ "$CURRENT_SHELL" == "$TARGET_SHELL" ]]; then
    log_verbose "Login shell already set to $TARGET_SHELL"
    exit 0
fi

echo "Current login shell is $CURRENT_SHELL"
if [[ ! -x "$TARGET_SHELL" ]]; then
    echo "Homebrew zsh is not available at $TARGET_SHELL"
    echo "Install it before changing the login shell. Chezmoi will not make this privileged change on work."
    exit 0
fi

echo "Homebrew zsh is available at $TARGET_SHELL"
echo "Chezmoi will not change the login shell automatically on work."

if ! grep -qxF "$TARGET_SHELL" "$SHELLS_FILE"; then
    echo "Ask an administrator to add this line to $SHELLS_FILE:"
    printf '  %s\n' "$TARGET_SHELL"
fi

echo "After $TARGET_SHELL is listed in $SHELLS_FILE, change the login shell with:"
printf '  chsh -s %s\n' "$TARGET_SHELL"
exit 0
{{ else -}}
TTY_AVAILABLE=false

if [[ -t 0 && -t 1 ]]; then
    TTY_AVAILABLE=true
fi

require_sudo() {
    if sudo -n true 2>/dev/null; then
        return 0
    fi

    if [[ "$TTY_AVAILABLE" == true ]]; then
        echo "Need sudo to update $SHELLS_FILE"
        sudo -v
        return 0
    fi

    echo "Need sudo to update $SHELLS_FILE, but no TTY available"
    exit 1
}

prompt_confirm() {
    local reply

    if [[ "$TTY_AVAILABLE" != true ]]; then
        return 0
    fi

    printf 'Update login shell to %s and /etc/shells if needed? [y/N] ' "$TARGET_SHELL"
    read -r reply
    case "$reply" in
        y | Y | yes | YES)
            return 0
            ;;
        *)
            echo "Aborted"
            exit 0
            ;;
    esac
}

if [[ ! -x "$TARGET_SHELL" ]]; then
    echo "Target shell $TARGET_SHELL not found or not executable"
    exit 1
fi

SHELLS_HAS_TARGET=false
if grep -qxF "$TARGET_SHELL" "$SHELLS_FILE"; then
    SHELLS_HAS_TARGET=true
fi

if [[ "$CURRENT_SHELL" == "$TARGET_SHELL" && "$SHELLS_HAS_TARGET" == true ]]; then
    log_verbose "Shell already set to $TARGET_SHELL"
    exit 0
fi

if [[ "$CURRENT_SHELL" != "$TARGET_SHELL" || "$SHELLS_HAS_TARGET" != true ]]; then
    prompt_confirm
fi

if [[ "$SHELLS_HAS_TARGET" != true ]]; then
    require_sudo
    echo "Adding $TARGET_SHELL to $SHELLS_FILE"
    printf '%s\n' "$TARGET_SHELL" | sudo tee -a "$SHELLS_FILE" >/dev/null
fi

if [[ "$CURRENT_SHELL" != "$TARGET_SHELL" ]]; then
    echo "Changing login shell from $CURRENT_SHELL to $TARGET_SHELL"
    chsh -s "$TARGET_SHELL"
    echo "Shell changed successfully. New login sessions use $TARGET_SHELL"
else
    log_verbose "Login shell already set to $TARGET_SHELL"
fi
{{ end -}}
