#!/usr/bin/env bash

set -euo pipefail

mise_bin={{ joinPath .homebrewPrefix "bin" "mise" | quote }}
node_runtime={{ printf "node@%s" .versions.node.default | quote }}
skills_cli={{ printf "%s@%s" .agentSkills.cli.package .agentSkills.cli.version | quote }}

if [[ ! -x "$mise_bin" ]]; then
    echo "Missing mise executable: $mise_bin" >&2
    exit 1
fi

{{ range .agentSkills.sources -}}
install_args=(
    add
    {{ .source | quote }}
    --global
    --agent universal
)
{{ range .skills -}}
install_args+=(--skill {{ . | quote }})
{{ end -}}
install_args+=(--yes)

"$mise_bin" exec "$node_runtime" -- npx --yes "$skills_cli" "${install_args[@]}"
{{ end }}
echo "✓ Installed required global agent skills"
