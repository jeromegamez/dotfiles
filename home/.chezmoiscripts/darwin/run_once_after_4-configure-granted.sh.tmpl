#!/usr/bin/env bash

set -euo pipefail

granted_bin={{ joinPath .homebrewPrefix "bin" "granted" | quote }}

if [[ ! -x "$granted_bin" ]]; then
    echo "Missing Granted executable: $granted_bin" >&2
    exit 1
fi

if [[ -n "${CHEZMOI_VERBOSE:-}" ]]; then
    "$granted_bin" settings set \
        --setting CredentialProcessAutoLogin \
        --value true
else
    output=""
    if output=$("$granted_bin" settings set \
        --setting CredentialProcessAutoLogin \
        --value true 2>&1); then
        :
    else
        status=$?
        if [[ -n "$output" ]]; then
            printf '%s\n' "$output" >&2
        fi
        exit "$status"
    fi
fi

echo "✓ Enabled Granted credential-process auto-login"
