#!/usr/bin/env bash

set -euo pipefail

mise_bin={{ joinPath .homebrewPrefix "bin" "mise" | quote }}
homebrew_prefix={{ .homebrewPrefix | quote }}
data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
pi_prefix="$data_home/pi"
pi_agent_dir="$HOME/.pi/agent"
pi_entrypoint="$pi_agent_dir/bin/pi"
pi_launcher="$HOME/.local/bin/pi"
pi_node={{ printf "node@%s" .versions.node.pi | quote }}
pi_package="@earendil-works/pi-coding-agent"
installer=""

cleanup() {
    if [[ -n "$installer" && -f "$installer" ]]; then
        unlink "$installer"
    fi
}
trap cleanup EXIT

if [[ ! -x "$pi_entrypoint" || ! -f "$pi_agent_dir/install/current-version" ]]; then
    echo "==> Install managed Pi with mise-managed $pi_node"
    installer="$(mktemp "${TMPDIR:-/tmp}/pi-installer.XXXXXX")"
    curl -fsSL https://pi.dev/install.sh -o "$installer"
    # Expose the real npm install, hide our wrapper, and keep installer links out of Homebrew.
    PATH="$pi_prefix/bin:$pi_agent_dir/bin:/usr/bin:/bin:/usr/sbin:/sbin" \
        PI_CODING_AGENT_DIR="$pi_agent_dir" \
        "$mise_bin" exec "$pi_node" -- sh "$installer"
    if [[ ! -x "$pi_entrypoint" || ! -f "$pi_agent_dir/install/current-version" ]]; then
        echo "==> Skip Pi setup: no managed installation was activated"
        exit 0
    fi
fi

if [[ ! -x "$pi_launcher" ]]; then
    echo "Missing managed Pi launcher: $pi_launcher" >&2
    exit 1
fi

"$mise_bin" exec "$pi_node" -- "$pi_entrypoint" --version
"$pi_launcher" --version

if [[ -d "$homebrew_prefix/lib/node_modules/$pi_package" ]]; then
    echo "==> Remove legacy Pi installation from the Homebrew npm prefix"
    "$mise_bin" exec "$pi_node" -- npm uninstall \
        --global \
        --ignore-scripts \
        --prefix "$homebrew_prefix" \
        --no-audit \
        --no-fund \
        "$pi_package"
fi

echo "✓ Pi uses mise-managed $pi_node"
