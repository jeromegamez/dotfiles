#!/usr/bin/env bash

set -euo pipefail

APP_NAME="GhostPepper"
APP_PATH="/Applications/${APP_NAME}.app"
REPO="matthartman/ghost-pepper"
RELEASE_URL="https://github.com/${REPO}/releases/download"
temp_dir=""
mount_point=""
dmg_path=""

cleanup() {
    if [[ -n "$mount_point" ]] && mount | grep -q "on ${mount_point} "; then
        hdiutil detach "$mount_point" -quiet || true
    fi
    if [[ -n "$temp_dir" && -d "$temp_dir" ]]; then
        rm -rf "$temp_dir"
    fi
}

trap cleanup EXIT INT TERM

get_latest_version() {
    curl -fsSL "https://api.github.com/repos/${REPO}/releases/latest" \
        | python3 -c 'import json, sys; print(json.load(sys.stdin)["tag_name"].lstrip("v"))'
}

get_installed_version() {
    if [[ -d "$APP_PATH" ]]; then
        defaults read "${APP_PATH}/Contents/Info.plist" CFBundleShortVersionString 2>/dev/null || echo ""
    else
        echo ""
    fi
}

install_ghost_pepper() {
    local version="$1"

    temp_dir=$(mktemp -d)
    dmg_path="${temp_dir}/${APP_NAME}.dmg"
    mount_point="${temp_dir}/mount"

    echo "Installing ${APP_NAME} v${version}..."

    echo "Downloading ${APP_NAME}..."
    curl -fsSL -L "${RELEASE_URL}/v${version}/${APP_NAME}.dmg" -o "$dmg_path"

    echo "Verifying DMG..."
    hdiutil verify "$dmg_path" >/dev/null

    echo "Mounting DMG..."
    mkdir -p "$mount_point"
    hdiutil attach "$dmg_path" -mountpoint "$mount_point" -nobrowse -readonly -quiet

    if [[ ! -d "${mount_point}/${APP_NAME}.app" ]]; then
        echo "✗ ${APP_NAME}.app missing in DMG"
        exit 1
    fi

    echo "Copying to /Applications..."
    rm -rf "${APP_PATH}.tmp"
    cp -R "${mount_point}/${APP_NAME}.app" "${APP_PATH}.tmp"
    rm -rf "$APP_PATH"
    mv "${APP_PATH}.tmp" "$APP_PATH"

    echo "Unmounting DMG..."
    hdiutil detach "$mount_point" -quiet
    mount_point=""

    echo "✓ ${APP_NAME} v${version} installed successfully"
}

LATEST_VERSION=$(get_latest_version)
INSTALLED_VERSION=$(get_installed_version)

if [[ "$INSTALLED_VERSION" == "$LATEST_VERSION" ]]; then
    echo "✓ ${APP_NAME} is up to date (${INSTALLED_VERSION})"
else
    install_ghost_pepper "$LATEST_VERSION"
fi
