#!/usr/bin/env bash

set -euo pipefail

brew={{ joinPath .homebrewPrefix "bin" "brew" | quote }}

legacy_formulae=(
    gnupg
    pinentry-mac
)

for formula in "${legacy_formulae[@]}"; do
    if "$brew" list --formula "$formula" >/dev/null 2>&1; then
        installed_dependents=$("$brew" uses --installed "$formula")
        if [[ -n "$installed_dependents" ]]; then
            printf 'Warning: retained Homebrew formula %s because it is used by installed dependent(s):\n%s\n' "$formula" "$installed_dependents" >&2
            continue
        fi
        "$brew" uninstall --formula "$formula"
    fi
done

legacy_cask=gpg-suite-no-mail
if "$brew" list --cask "$legacy_cask" >/dev/null 2>&1; then
    "$brew" uninstall --cask "$legacy_cask"
fi

echo "Legacy personal GPG package cleanup completed for the work profile"
