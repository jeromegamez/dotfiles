#!/usr/bin/env bash
{{- $sources := list -}}
{{- with .agentSkills.sources.common -}}
{{-   $sources = concat $sources . -}}
{{- end -}}
{{- if .personal -}}
{{-   with .agentSkills.sources.personal -}}
{{-     $sources = concat $sources . -}}
{{-   end -}}
{{- end -}}
{{- if .work -}}
{{-   with .agentSkills.sources.work -}}
{{-     $sources = concat $sources . -}}
{{-   end -}}
{{- end }}

# agent-skills configuration fingerprint: {{ dict "cli" .agentSkills.cli "sources" $sources | toJson | sha256sum }}
set -euo pipefail

homebrew_bin={{ joinPath .homebrewPrefix "bin" | quote }}
npx_bin="$homebrew_bin/npx"
skills_cli={{ printf "%s@%s" .agentSkills.cli.package .agentSkills.cli.version | quote }}

if [[ ! -x "$npx_bin" ]]; then
    echo "Missing npx executable: $npx_bin" >&2
    exit 1
fi

export PATH="$homebrew_bin:$PATH"

{{ range $sources -}}
install_args=(
    add
    {{ .source | quote }}
    --global
    --agent universal
    --full-depth
)
{{ range .skills -}}
install_args+=(--skill {{ . | quote }})
{{ end -}}
install_args+=(--yes)

"$npx_bin" --yes "$skills_cli" "${install_args[@]}"
{{ end }}
echo "✓ Installed required global agent skills"
