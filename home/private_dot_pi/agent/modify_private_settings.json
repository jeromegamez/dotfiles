{{- /* chezmoi:modify-template */ -}}
{{- $cfg := dict -}}
{{- if (trim .chezmoi.stdin) -}}
{{-   $cfg = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $cfg = setValueAtPath "defaultProjectTrust" "always" $cfg -}}
{{- $cfg = setValueAtPath "quietStartup" "header" $cfg -}}
{{- $cfg = setValueAtPath "showCacheMissNotices" true $cfg -}}
{{- $packages := list -}}
{{- if and (hasKey $cfg "packages") (index $cfg "packages") -}}
{{-   range (index $cfg "packages") -}}
{{-     $packages = append $packages . -}}
{{-   end -}}
{{- end -}}
{{- with .agentAddons.pi -}}
{{-   range .packages -}}
{{-     if not (has . $packages) -}}
{{-       $packages = append $packages . -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- $cfg = setValueAtPath "packages" $packages $cfg -}}
{{- $cfg | toPrettyJson -}}